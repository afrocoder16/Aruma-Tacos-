---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import ReservationDialog from '../components/ReservationDialog.astro';
import { fullMenu, site } from '../data/site';
import '../styles/menu-sample-two.css';

import birriaImage from '../assets/images/menu/Quesabirria.png';
import fajitasImage from '../assets/images/fajitas.jpg';
import cocktailImage from '../assets/images/aruma-cocktail.png';
import churrosImage from '../assets/images/churros.jpg';
import tacoSpreadImage from '../assets/images/sample-taco-spread.jpg';
import margaritaImage from '../assets/images/menu/house margarita.png';
import guacamoleImage from '../assets/images/sample-guacamole.jpg';
import streetTacosImage from '../assets/images/sample-street-tacos.jpg';
import alPastorImage from '../assets/images/sample-al-pastor.jpg';
import streetCornImage from '../assets/images/sample-street-corn.jpg';
import flanImage from '../assets/images/sample-flan.jpg';
import friedIceCreamImage from '../assets/images/sample-fried-ice-cream.jpg';
import palomaImage from '../assets/images/menu/smoked paloma.png';
import horchataImage from '../assets/images/menu/dirty horchata.png';
import streetTacosMenuImage from '../assets/images/menu/Street Tacos.png';
import ribeyeTacosImage from '../assets/images/menu/Ribeye Tacos.png';
import alPastorMenuImage from '../assets/images/menu/Al Pastor.png';
import arumaSpecialImage from '../assets/images/menu/Aruma Special AI.png';
import carneAsadaImage from '../assets/images/menu/Carne Asada.png';
import polloChipotleImage from '../assets/images/menu/Pollo Chipotle AI.png';
import reposadoArumaImage from '../assets/images/menu/reposado aruma.png';
import tresLechesImage from '../assets/images/menu/Tres Leches AI.png';

const itemPhotoAssets = {
  spread: tacoSpreadImage,
  guacamole: guacamoleImage,
  tacos: streetTacosImage,
  alPastor: alPastorImage,
  streetCorn: streetCornImage,
  birria: birriaImage,
  fajitas: fajitasImage,
  margarita: margaritaImage,
  paloma: palomaImage,
  horchata: horchataImage,
  cocktail: cocktailImage,
  churros: churrosImage,
  flan: flanImage,
  friedIceCream: friedIceCreamImage,
  streetTacos: streetTacosMenuImage,
  ribeyeTacos: ribeyeTacosImage,
  alPastorMenu: alPastorMenuImage,
  arumaSpecial: arumaSpecialImage,
  carneAsada: carneAsadaImage,
  polloChipotle: polloChipotleImage,
  reposadoAruma: reposadoArumaImage,
  tresLeches: tresLechesImage,
} as const;

const itemPhotos = Object.fromEntries(await Promise.all(
  Object.entries(itemPhotoAssets).map(async ([key, src]) => {
    const image = await getImage({ src, width: 1200, quality: 72, format: 'webp' });
    return [key, image.src];
  }),
)) as Record<keyof typeof itemPhotoAssets, string>;

const getItemPhoto = (groupId: string, itemName: string) => {
  if (itemName === 'Guacamole') return 'guacamole';
  if (itemName === 'Street Corn') return 'streetCorn';
  if (itemName === 'Quesabirria') return 'birria';
  if (itemName === 'Al Pastor') return 'alPastorMenu';
  if (itemName === 'Ribeye') return 'ribeyeTacos';
  if (itemName === 'Aruma Special') return 'arumaSpecial';
  if (itemName === 'Carne Asada') return 'carneAsada';
  if (itemName === 'Pollo Chipotle') return 'polloChipotle';
  if (itemName === 'Reposado Aruma') return 'reposadoAruma';
  if (itemName === 'Smoked Paloma') return 'paloma';
  if (itemName === 'Dirty Horchata') return 'horchata';
  if (itemName === 'Tres Leches') return 'tresLeches';
  if (itemName === 'Flan') return 'flan';
  if (itemName === 'Fried Ice Cream') return 'friedIceCream';
  if (groupId === 'tacos') return 'streetTacos';
  if (groupId === 'share') return 'spread';
  if (groupId === 'signatures' || groupId === 'fajitas') return 'fajitas';
  if (groupId === 'cocktails' && ['House Margarita', 'Reposado Aruma', 'Margarita Flight'].includes(itemName)) return 'margarita';
  if (groupId === 'cocktails' || groupId === 'agave') return 'cocktail';
  return 'churros';
};

const menuVisuals = {
  share: { image: tacoSpreadImage, alt: 'Colorful tacos and shared plates on a wooden table', callout: 'Pass it around', featured: 'Guacamole' },
  tacos: { image: birriaImage, alt: 'Crisped quesabirria tacos with consommé and lime', callout: 'Dip. Bite. Repeat.', featured: 'Quesabirria' },
  signatures: { image: fajitasImage, alt: 'A sizzling skillet of steak, shrimp, and vegetables', callout: 'Born from the fire', featured: 'Aruma Special' },
  fajitas: { image: fajitasImage, alt: 'Aruma fajitas served hot from the kitchen', callout: 'Hear them coming', featured: 'Fajitas Aruma' },
  cocktails: { image: margaritaImage, alt: 'A classic margarita with a salted rim and fresh lime', callout: 'Bright by design', featured: 'House Margarita' },
  agave: { image: cocktailImage, alt: 'A handcrafted smoky citrus cocktail at Aruma', callout: 'Sip with intention', featured: 'Vida Oaxaca' },
  sweets: { image: churrosImage, alt: 'Warm cinnamon sugar churros with dipping sauces', callout: 'There is always room', featured: 'Churros' },
} as const;

const picks = [
  { name: 'Quesabirria', note: 'Slow-braised · molten cheese · consommé', price: '18', image: birriaImage, alt: 'Aruma quesabirria tacos' },
  { name: 'Fajitas Aruma', note: 'Steak · chicken · shrimp · chorizo', price: '44', image: fajitasImage, alt: 'Aruma signature fajitas' },
  { name: 'House Margarita', note: 'Blanco · lime · orange · agave', price: '10', image: margaritaImage, alt: 'Classic lime margarita' },
] as const;

const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Digital Menu | Aruma Tacos & Tequila" description="Explore Aruma's visual menu of tacos, house signatures, margaritas, and more in Marshall, Minnesota.">
  <div class="noise" aria-hidden="true"></div>
  <header class="m2-header">
    <a class="brand" href={homeUrl} aria-label="Aruma Tacos & Tequila home"><BrandMark class="brand__mark" /><span class="brand__type"><b>ARUMA</b><small>TACOS &amp; TEQUILA</small></span></a>
    <div class="m2-header__concept"><span>45</span><p>PLATES &amp; POURS<br /><b>THE VISUAL MENU</b></p></div>
    <nav aria-label="Menu navigation"><a href={homeUrl}>Home</a><a href="#full-menu">Explore menu</a><button type="button" data-reserve-open>Reserve <span class="icon-arrow-up-right" aria-hidden="true"></span></button></nav>
  </header>

  <main class="m2" id="menu-top">
    <section class="m2-hero">
      <div class="m2-hero__copy">
        <p><span>ARUMA · MARSHALL, MINNESOTA</span><i></i>THE VISUAL MENU</p>
        <h1>Pick your<br /><em>craving.</em></h1>
        <div class="m2-hero__intro"><span>01</span><p>Fire-kissed plates, bright agave pours, and the dishes everyone reaches across the table for.</p></div>
        <a href="#full-menu">Start exploring <i>↓</i></a>
      </div>
      <div class="m2-hero__collage">
        <figure class="m2-hero__image m2-hero__image--main">
          <Image src={tacoSpreadImage} alt="A colorful spread of tacos on traditional plates" widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 58vw" quality={68} loading="eager" />
          <figcaption><span>THE TABLE STARTS HERE</span><strong>Pass everything.</strong></figcaption>
        </figure>
        <figure class="m2-hero__image m2-hero__image--small"><Image src={margaritaImage} alt="A salt-rimmed margarita with fresh lime" width={540} quality={64} loading="eager" /><figcaption>POUR NO. 01</figcaption></figure>
        <div class="m2-hero__seal" aria-hidden="true"><small>FRESH FIRE</small><strong>45</strong><span>PLATES &amp; POURS</span></div>
      </div>
    </section>

    <section class="m2-search" aria-label="Search and browse the menu">
      <div><label for="m2-menu-search">What are you hungry for?</label><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg><input id="m2-menu-search" type="search" placeholder="Search tacos, shrimp, mezcal…" autocomplete="off" data-m2-search /><button type="button" data-m2-clear hidden>Clear</button></span></div>
      <p><strong data-m2-count>{fullMenu.reduce((total, group) => total + group.items.length, 0)}</strong><span>things worth<br />ordering</span></p>
    </section>

    <nav class="m2-categories" aria-label="Menu categories"><span>JUMP TO</span><div>{fullMenu.map((group, index) => (<a class:list={{ 'is-active': index === 0 }} href={'#m2-' + group.id} data-m2-category={group.id}><small>{String(index + 1).padStart(2, '0')}</small>{group.category}</a>))}</div></nav>

    <section class="m2-picks" aria-labelledby="m2-picks-heading">
      <header><p><span>ARUMA’S SHORTLIST</span> Don’t overthink it</p><h2 id="m2-picks-heading">Three very<br /><em>good ideas.</em></h2></header>
      <div class="m2-picks__grid">
        {picks.map((pick, index) => (
          <article>
            <figure><Image src={pick.image} alt={pick.alt} widths={[480, 720, 960]} sizes="(max-width: 700px) 100vw, 33vw" quality={70} loading="lazy" /><span>0{index + 1}</span></figure>
            <div><small>ARUMA PICK</small><h3>{pick.name}</h3><p>{pick.note}</p></div>
            <strong>{'$'}{pick.price}</strong>
            <a href="#full-menu"><span>↓</span> View full menu</a>
          </article>
        ))}
      </div>
    </section>

    <div class="m2-menu" id="full-menu">
      {fullMenu.map((group, groupIndex) => {
        const visual = menuVisuals[group.id as keyof typeof menuVisuals];
        return (
          <section class:list={['m2-group', { 'm2-group--reverse': groupIndex % 2 === 1, 'm2-group--dark': group.id === 'cocktails' || group.id === 'agave' }]} id={'m2-' + group.id} data-m2-group>
            <figure class="m2-group__visual">
              <Image src={visual.image} alt={visual.alt} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 47vw" quality={68} loading="lazy" />
              <figcaption><span>{visual.callout}</span><strong>{visual.featured}</strong></figcaption><i aria-hidden="true">{String(groupIndex + 1).padStart(2, '0')}</i>
            </figure>
            <div class="m2-group__menu">
              <header><span>{String(groupIndex + 1).padStart(2, '0')} · {group.note}</span><h2>{group.category}</h2><p>{group.id === 'tacos' ? 'Three per order · rice · beans · verde · picante' : group.id === 'cocktails' ? 'Fresh citrus · premium pours · shaken to order' : 'Built fresh and meant to be shared.'}</p></header>
              <div class="m2-group__items">
                {group.items.map((item) => {
                  const photoKey = getItemPhoto(group.id, item[0]);
                  return (
                    <article
                      data-m2-item
                      data-search={[item[0], item[1], group.category].join(' ').toLowerCase()}
                      data-image={itemPhotos[photoKey]}
                      data-name={item[0]}
                      data-description={item[1]}
                      data-price={item[2]}
                      data-category={group.category}
                    >
                      <button class="m2-item__select" type="button" data-m2-view aria-label={`View ${item[0]}`}>
                        <span class="m2-item__thumb"><img src={itemPhotos[photoKey]} alt="" loading="lazy" /></span>
                        <span class="m2-item__copy"><span>View dish</span><h3>{item[0]}</h3><p>{item[1]}</p></span>
                        <strong>{'$'}{item[2]}</strong>
                        <i class="icon-arrow-up-right" aria-hidden="true"></i>
                      </button>
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
        );
      })}
    </div>

    <section class="m2-empty" hidden data-m2-empty><span>NO MATCH YET</span><h2>Try another craving.</h2><p>Search by dish, ingredient, or category.</p><button type="button" data-m2-clear>Clear search</button></section>
    <section class="m2-last-call"><div><span>ONE LAST THING</span><h2>Your table is<br /><em>waiting.</em></h2><p>Come hungry. Bring people you like. We’ll handle the rest.</p><div><button type="button" data-reserve-open>Reserve a table <span class="icon-arrow-up-right" aria-hidden="true"></span></button><a href={site.directions} target="_blank" rel="noopener">Find Aruma <span class="icon-arrow-up-right" aria-hidden="true"></span></a></div></div><figure><Image src={birriaImage} alt="Quesabirria tacos ready to share" width={1500} quality={84} loading="lazy" /></figure></section>
  </main>

  <dialog class="m2-dish" data-m2-dish-dialog aria-labelledby="m2-dish-name">
    <button class="m2-dish__close" type="button" data-m2-dish-close aria-label="Close dish details">Close <span>×</span></button>
    <div class="m2-dish__photo"><img src={itemPhotos.guacamole} alt="" data-m2-dish-image /><span>VISUAL MENU · TAP TO CHOOSE</span><i data-m2-dish-price>$12</i></div>
    <div class="m2-dish__details">
      <p><span data-m2-dish-category>For the table</span><i></i>ARUMA MENU</p>
      <h2 id="m2-dish-name" data-m2-dish-name>Guacamole</h2>
      <p data-m2-dish-description>Avocado · pico · lime · warm chips</p>
      <div><button type="button" data-m2-dish-close><span>←</span> Back to menu</button><small>Browse the visual menu, then order with your server at Aruma.</small></div>
    </div>
    <div class="m2-dish__hint">Choose another dish from the menu to change this view.</div>
  </dialog>

  <footer class="m2-footer">
    <a class="brand" href={homeUrl}><BrandMark class="brand__mark" /><span class="brand__type"><b>ARUMA</b><small>TACOS &amp; TEQUILA</small></span></a>
    <p>{site.address}<br />Lunch · Dinner · Late pours</p>
    <p>Menu availability and pricing may change. Please tell the Aruma team about food allergies before ordering.</p>
    <a href="#menu-top">Back to top ↑</a>
  </footer>
  <ReservationDialog />

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-m2-search]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-m2-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-m2-group]')];
    const count = document.querySelector<HTMLElement>('[data-m2-count]');
    const empty = document.querySelector<HTMLElement>('[data-m2-empty]');
    const clearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-m2-clear]')];

    const filterMenu = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let visible = 0;
      items.forEach((item) => { const matches = !query || item.dataset.search?.includes(query); item.hidden = !matches; if (matches) visible += 1; });
      groups.forEach((group) => group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-m2-item]')].some((item) => !item.hidden));
      clearButtons.forEach((button) => button.hidden = !query);
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener('input', filterMenu);
    clearButtons.forEach((button) => button.addEventListener('click', () => { if (search) search.value = ''; filterMenu(); search?.focus(); }));

    const dishDialog = document.querySelector<HTMLDialogElement>('[data-m2-dish-dialog]');
    const dishImage = document.querySelector<HTMLImageElement>('[data-m2-dish-image]');
    const dishName = document.querySelector<HTMLElement>('[data-m2-dish-name]');
    const dishDescription = document.querySelector<HTMLElement>('[data-m2-dish-description]');
    const dishCategory = document.querySelector<HTMLElement>('[data-m2-dish-category]');
    const dishPrice = document.querySelector<HTMLElement>('[data-m2-dish-price]');

    items.forEach((item) => item.querySelector('[data-m2-view]')?.addEventListener('click', () => {
      const { image, name, description, price, category } = item.dataset;
      if (dishImage && image) { dishImage.src = image; dishImage.alt = `${name ?? 'Selected dish'} — visual reference`; }
      if (dishName) dishName.textContent = name ?? '';
      if (dishDescription) dishDescription.textContent = description ?? '';
      if (dishCategory) dishCategory.textContent = category ?? '';
      if (dishPrice) dishPrice.textContent = `$${price ?? ''}`;
      dishDialog?.showModal();
      document.body.classList.add('m2-dialog-open');
    }));
    document.querySelectorAll('[data-m2-dish-close]').forEach((button) => button.addEventListener('click', () => dishDialog?.close()));
    dishDialog?.addEventListener('click', (event) => { if (event.target === dishDialog) dishDialog.close(); });
    dishDialog?.addEventListener('close', () => document.body.classList.remove('m2-dialog-open'));

    const categoryLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-m2-category]')];
    const observer = new IntersectionObserver((entries) => {
      const active = entries.find((entry) => entry.isIntersecting);
      if (!active) return;
      const id = active.target.id.replace('m2-', '');
      categoryLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.m2Category === id));
      categoryLinks.find((link) => link.classList.contains('is-active'))?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }, { rootMargin: '-25% 0px -65% 0px' });
    groups.forEach((group) => observer.observe(group));
  </script>
</BaseLayout>
